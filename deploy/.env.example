# Copy to deploy/.env and fill in. deploy/.env is git-ignored.

# Database password (any long random string).
# Letters and digits only; it is embedded in a database URL.
POSTGRES_PASSWORD=changeme0to0something0long

# Encrypts stored passwords (e.g. calendar logins). A long random string, e.g. from
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Back it up with the database: if it changes, saved passwords can't be read.
TAHGUL_SECRET_KEY=change-me-to-a-long-random-string

# The calendar server in the stack. Your iPhone logs in with these too
# (Calendar accounts → Add Account → Other → CalDAV, server
#  tahgul.<tailnet>.ts.net:8443). See docs/calendar.md.
RADICALE_USER=connor
RADICALE_PASSWORD=change-me-too

# Creates the owner account on first start if none exists. Remove both lines
# afterwards, or create the owner with:
#   docker compose -f deploy/docker-compose.yml exec api tahgul create-owner --email you@example.com
TAHGUL_OWNER_EMAIL=
TAHGUL_OWNER_PASSWORD=

# Local development over plain http://localhost:8000 needs this false.
# Leave it true (the default) behind Tailscale HTTPS.
TAHGUL_COOKIE_SECURE=false

# Host port for local access (bound to 127.0.0.1 only).
TAHGUL_PORT=8000

# Homelab only (--profile tailscale): an auth key from the Tailscale admin console.
TS_AUTHKEY=

# Transcription (--profile whisper). Leave empty to turn it off.
TAHGUL_WHISPER_URL=
# TAHGUL_WHISPER_MODEL=Systran/faster-whisper-small
# TAHGUL_WHISPER_LANGUAGE=en

# Client report links on the public internet (--profile public-reports, and
# TS_SERVE_FILE=serve-public-reports.json). The address they're shared under:
# TAHGUL_PUBLIC_REPORT_URL=https://tahgul.<tailnet>.ts.net:10000
# TS_SERVE_FILE=serve-public-reports.json
