# Copy to deploy/.env and fill in. deploy/.env is git-ignored.

# Database password (any long random string).
# Letters and digits only; it is embedded in a database URL.
POSTGRES_PASSWORD=changeme0to0something0long

# Creates the owner account on first start if none exists. Remove both lines
# afterwards, or create the owner with:
#   docker compose -f deploy/docker-compose.yml exec api tahgul create-owner --email you@example.com
TAHGUL_OWNER_EMAIL=
TAHGUL_OWNER_PASSWORD=

# Local development over plain http://localhost:8000 needs this false.
# Leave it true (the default) behind Tailscale HTTPS.
TAHGUL_COOKIE_SECURE=false

# Host port for local access (bound to 127.0.0.1 only).
TAHGUL_PORT=8000

# Homelab only (--profile tailscale): an auth key from the Tailscale admin console.
TS_AUTHKEY=
